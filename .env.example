# Copy to .env.local and fill in. Never commit .env.local.
#
# A blank value means "not set" and falls back to the default below it — that is
# how a person un-sets a variable in a dashboard, so the schema treats it as
# absence rather than as zero (lib/env.ts). A value that is present and wrong
# still fails loudly.

# --- Supabase (create the project in an EU region: eu-central-1 / Frankfurt) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used by seed and ingestion scripts. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Needed by the Supabase CLI
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=

# --- Text generation: OPTIONAL ---
#
# Nothing in retrieval needs a key. Search, ingestion, classification, the
# Clinical Report Check bar its completeness pass, precedent retrieval and the
# confidence gate are all SQL and regex (ADR-039). Only Features 3 and 6 and
# that one pass call a model, and with no key they refuse and say why rather
# than degrading silently.
#
# Set ONE of these. Groq wins if both are present: the Gemini variables ship
# with defaults and are easy to leave lying around, a Groq key is not (ADR-035).

# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Models ---
#
# Measured against the same request, not assumed (ADR-037). The verifier is
# deliberately a different family from the drafter: a grader that shares the
# drafter's blind spots agrees with it, and ADR-006 wants a check, not a chorus.
GROQ_MODEL_FAST=openai/gpt-oss-120b
GROQ_MODEL_STRONG=qwen/qwen3.8-27b
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_STRONG=gemini-2.5-pro

# --- The refusal gate (calibrate with `npm run eval`, see docs/05-EVALUATION.md) ---
#
# Trigram overlap in 0..1, NOT cosine similarity. 0.62 was the old threshold and
# was tuned for embeddings, where a paraphrase scores high; on shared wording the
# same answerable requests land between 0.36 and 1.00 while requests with no
# precedent land at 0.00. 0.25 sits in that gap.
DRAFT_LEXICAL_THRESHOLD=0.25

# --- Cost telemetry: OPTIONAL, per purpose, USD per million tokens ---
#
# Unset means `ai_calls.cost_usd` stays null. An absent cost is honest; an
# invented one would put a wrong number on a slide that claims to be measured.
# Purposes: EMBED EXTRACT DRAFT SUGGEST COMPLETENESS REVIEW VERIFY RERANK
# AI_USD_PER_MTOK_DRAFT=
# AI_USD_PER_MTOK_VERIFY=

# --- Seed ---
SEED_RANDOM_SEED=42
