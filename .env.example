# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (create the project in an EU region: eu-central-1 / Frankfurt) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used by seed and ingestion scripts. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Needed by the Supabase CLI for `npm run db:migrate`
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Models ---
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_STRONG=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Retrieval tuning (calibrate with `npm run eval`, see docs/05-EVALUATION.md) ---
RRF_K=60
DRAFT_SIMILARITY_THRESHOLD=0.62

# --- Seed ---
SEED_RANDOM_SEED=42
