{
  "name": "rfi-vault",
  "version": "0.1.0",
  "private": true,
  "description": "Repository for EU CTR validation RFI considerations and sponsor responses — Novo Nordisk GBS Hackathon 2026, problem statement 18",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "supabase db push",
    "db:types": "supabase gen types typescript --linked > lib/db/types.ts",
    "seed": "tsx scripts/seed/run.ts",
    "eval": "tsx scripts/eval/run.ts",
    "verify": "tsx scripts/verify/smoke.ts",
    "ingest": "tsx scripts/ingest/run.ts",
    "fixtures:pdf": "python scripts/fixtures/make_rfi_pdf.py",
    "setup:storage": "tsx scripts/setup/storage.ts",
    "verify:ingest": "tsx scripts/verify/ingest-e2e.ts",
    "embed": "tsx scripts/embed/run.ts",
    "verify:assess": "tsx scripts/verify/assess.ts",
    "verify:dashboards": "tsx scripts/verify/dashboards.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.41",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "ai": "^7.0.59",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "supabase": "^2.113.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
