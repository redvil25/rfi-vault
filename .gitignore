# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — the example template IS committed, real secrets never are
.env*
!.env.example

# supabase cli
/supabase/.temp
/supabase/.branches

# playwright
/test-results
/playwright-report
/blob-report

# local dev server output
dev.log

# typescript
*.tsbuildinfo
next-env.d.ts

# Tesseract writes its language cache to the working directory by default.
# The vendored copy under vendor/tessdata is what we use; ignore stray downloads.
/eng.traineddata
*.traineddata.gz

.vercel
